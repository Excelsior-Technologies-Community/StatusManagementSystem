@model StatusManagementSystem.Models.StatusModel

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <div>
            <h4 class="fw-bold">ADD STATUS</h4>
            <small class="text-muted">Dashboard / Status / Add Status</small>
        </div>

        <a href="/Status/Index" class="btn btn-primary btn-sm">BACK</a>
    </div>

    <div class="card shadow-sm border-0 p-4">

        <form method="post">
            <input type="hidden" name="ID" value="@Model.ID" />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Code *</label>
                    <input type="text" name="StatusCode" value="@Model.StatusCode" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label>Title *</label>
                    <input type="text" name="Title" value="@Model.Title" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label>Description</label>
                <textarea name="Description" class="form-control">@Model.Description</textarea>
            </div>

            <button class="btn btn-primary">Update</button>

        </form>

    </div>

</div>