@model CurrencyModel

<div class="container-fluid mt-3">

    <div class="header-box d-flex justify-content-between">
        <div>
            <h5>ADD CURRENCY</h5>
            <small>Dashboard / Currency / Add Currency</small>
        </div>

    </div>

    <div class="intake-card">

        <form method="post">

            <div class="row">
                <div class="col-md-6">
                    <label>Title *</label>
                    <input name="Title" class="form-control" placeholder="Enter Title" />
                </div>

                <div class="col-md-6">
                    <label>Country *</label>
                    @Html.DropDownListFor(m => m.CountryId, Model.CountryList, "Select Country", new { @class = "form-control" })
                </div>
            </div>

            <div class="mt-3">
                <label>Description</label>
                <textarea name="Description" class="form-control"></textarea>
            </div>

            <div class="mt-3">
                <button name="submit" value="Save" class="btn btn-primary btn-sm">Save</button>
                <button name="submit" value="SaveAdd" class="btn btn-success btn-sm">Save & Add Another</button>
                <a href="/Currency/Index" class="btn btn-danger btn-sm">Cancel</a>
            </div>

        </form>

    </div>
</div>