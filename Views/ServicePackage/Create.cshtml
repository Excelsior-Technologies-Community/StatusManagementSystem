@model ServicePackageVM

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>

<form asp-action="Create" method="post" style="block-size:auto;">

    <div class="container-fluid mt-3">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold">ADD SERVICE PACKAGE</h5>
                <small class="text-muted">Dashboard / Service Package / Add Service Package</small>
            </div>
            <a href="/ServicePackage" class="btn btn-primary btn-sm">BACK</a>
        </div>

        <!-- ================= MAIN FORM ================= -->
        <div class="card shadow-sm p-4">

            <!-- ROW 1 -->
            <div class="row g-3">
                <div class="col-md-3">
                    <label>Service Package Title *</label>
                    <input asp-for="Service.Title" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>Service Report Header *</label>
                    <input asp-for="Service.ReportHeader" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>Alias *</label>
                    <input asp-for="Service.Alias" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>GST (%) *</label>
                    <select asp-for="Service.GSTId" asp-items="Model.GSTList" class="form-control"></select>
                </div>
            </div>

            <!-- ROW 2 -->
            <div class="row g-3 mt-2">
                <div class="col-md-3">
                    <label>Visa</label>
                    <select asp-for="Service.VisaTypeId" asp-items="Model.VisaTypeList" class="form-control"></select>
                </div>

                <div class="col-md-3">
                    <label>Country</label>
                    <select asp-for="Service.CountryId" asp-items="Model.CountryList" class="form-control"></select>
                </div>

                <div class="col-md-3">
                    <label>Visa Type</label>
                    <select asp-for="Service.VisaTypeId" asp-items="Model.VisaTypeList" class="form-control"></select>
                </div>
            </div>

            <!-- DESCRIPTION -->
            <div class="mt-3">
                <label>Description</label>
                <input type="textarea" asp-for="Service.Description" class="form-control"></input>
            </div>

            <!-- CHECKBOX GRID -->
            <div class="row mt-3">
                @foreach (var item in new[]{
                                ("Is Coaching","IsCoaching"),
                                ("Is Combo Service Package?","IsServiceComboPackage"),
                                ("Is In App Visible?","InAppShow"),
                                ("Is Agreements Send?","IsAgreementsSend"),
                                ("Is Receipt Send?","IsReceiptSend"),
                                ("Is College Application Activities?","IsCollegeApplication"),
                                ("Is Intake Show?","IsIntakeShow"),
                                ("Is First Meeting Show?","IsFirstMeetingShow"),
                                ("Is Agreements Send Button Show?","IsAgreementBtn"),
                                ("Is Agreements Download Show?","IsAgreementDownload"),
                                ("Is Receipt Send Button Show?","IsReceiptBtn"),
                                ("Is Receipt Download Show?","IsReceiptDownload"),
                                ("Is Show Invoice?","IsShowInvoice"),
                                ("Is Maximum Amount Allowed?","IsMaxAmount"),
                                ("Is Course Options?","IsCourse"),
                                ("Is Fees Payment?","IsFees"),
                                ("Is Post Decision Activities?","IsPostDecision"),
                                ("Is Allied Services?","IsAllied")
                                })
                {
                    <div class="col-md-2 mb-2">
                        <input type="checkbox" name="Service.@item.Item2" value="Yes" /> @item.Item1
                    </div>
                }
            </div>

        </div>

        <!-- ================= ACTIVITIES + QUESTIONS ================= -->
        <div class="row mt-3">

            <!-- ACTIVITIES -->
            <div class="col-md-6">
                <div class="card p-3 shadow-sm">
                    <div class="d-flex justify-content-between">
                        <h6>Activities List</h6>
                        <button type="button" class="btn btn-primary btn-sm" onclick="addActivity()">Add Activities</button>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-6">
                            <label>Activities *</label>
                            <select id="activitySelect" class="form-control"
                                    asp-items="Model.ActivityList">
                                <option value="">Select Activities</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label>Milestone Alias</label>
                            <input id="milestone" class="form-control" />
                        </div>

                        <div class="col-md-6 mt-2">
                            <label>On Activity Completion</label>
                            <input id="duedays" class="form-control" />
                        </div>

                        <div class="col-md-6 mt-2">
                            <label>Amount</label>
                            <input id="amount" class="form-control" value="0" />
                        </div>
                    </div>

                    <table class="table table-bordered mt-3" id="activityTable">
                        <thead>
                            <tr>
                                <th>Activities Name</th>
                                <th>Milestone Alias</th>
                                <th>Payment Due</th>
                                <th>Amount</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody></tbody>

                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total Amount :</td>
                                <td><input id="totalAmount" class="form-control" readonly value="0" /></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- QUESTIONS -->
            <div class="col-md-6">
                <div class="card p-3 shadow-sm">
                    <div class="d-flex justify-content-between">
                        <h6>Activities Question List</h6>
                        <button type="button" class="btn btn-primary btn-sm" onclick="addQuestion()">Add Activities Question</button>
                    </div>

                    <div class="mt-2">
                        <label>Question *</label>
                        <select id="questionSelect" class="form-control"
                                asp-items="Model.QuestionList">
                            <option value="">Select Question</option>
                        </select>
                    </div>

                    <table class="table table-bordered mt-3" id="questionTable">
                        <thead>
                            <tr>
                                <th>Question</th>
                                <th>Answer Type</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- ================= DOCUMENT ================= -->
        <div class="card mt-3 p-3 shadow-sm">
            <div class="d-flex justify-content-between">
                <h6>Document List</h6>
                <button type="button" class="btn btn-primary btn-sm" onclick="addDocument()">Add Document</button>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <label>Document Type *</label>
                    <select id="docType" class="form-control"
                            asp-items="Model.DocumentTypeList">
                        <option value="">Select Document Type</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label>Document *</label>
                    <select id="doc" class="form-control"
                            asp-items="Model.DocumentList">
                        <option value="">Select Document</option>
                    </select>
                </div>
            </div>

            <table class="table table-bordered mt-3" id="docTable">
                <thead>
                    <tr>
                        <th>Document Type</th>
                        <th>Document Name</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- ================= TERMS ================= -->
        <div class="card mt-3 p-3 shadow-sm">
            <h6>Agreements Terms and Condition</h6>
            <textarea asp-for="Service.TermsAndCondition"></textarea>
        </div>

        <!-- BUTTON -->
        <div class="mt-3">
            <button class="btn btn-primary">Submit</button>
            <a href="/ServicePackage" class="btn btn-danger">Cancel</a>
        </div>

    </div>
</form>

<script>
    function addActivity(){
        let amount = parseFloat(document.getElementById("amount").value) || 0;

        let row = `<tr>
            <td>${activitySelect.value}</td>
            <td>${milestone.value}</td>
            <td>${duedays.value}</td>
            <td class="amt">${amount}</td>
            <td><button onclick="this.closest('tr').remove();calcTotal()" class="btn btn-danger btn-sm">X</button></td>
        </tr>`;

        document.querySelector("#activityTable tbody").insertAdjacentHTML('beforeend', row);
        calcTotal();
    }

    function calcTotal(){
        let total = 0;
        document.querySelectorAll(".amt").forEach(x=> total += parseFloat(x.innerText)||0);
        document.getElementById("totalAmount").value = total;
    }

    function addQuestion(){
        let row = `<tr>
            <td>${questionSelect.value}</td>
            <td>Text</td>
            <td><button onclick="this.closest('tr').remove()" class="btn btn-danger btn-sm">X</button></td>
        </tr>`;
        document.querySelector("#questionTable tbody").insertAdjacentHTML('beforeend', row);
    }

    function addDocument(){
        let row = `<tr>
            <td>${docType.value}</td>
            <td>${doc.value}</td>
            <td><button onclick="this.closest('tr').remove()" class="btn btn-danger btn-sm">X</button></td>
        </tr>`;
        document.querySelector("#docTable tbody").insertAdjacentHTML('beforeend', row);
    }

    tinymce.init({
        selector: 'textarea',
        height: 300
    });
</script>