@model ServicePackageVM

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Service.ID" />

    <div class="container-fluid mt-3">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold">EDIT SERVICE PACKAGE</h5>
                <small class="text-muted">Dashboard / Service Package / Edit Service Package</small>
            </div>
            <a href="/ServicePackage" class="btn btn-primary btn-sm">BACK</a>
        </div>

        <!-- ================= MAIN FORM ================= -->
        <div class="card shadow-sm p-4">

            <div class="row g-3">
                <div class="col-md-3">
                    <label>Service Package Title *</label>
                    <input asp-for="Service.Title" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>Service Report Header *</label>
                    <input asp-for="Service.ReportHeader" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>Alias *</label>
                    <input asp-for="Service.Alias" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>GST (%) *</label>
                    <select asp-for="Service.GSTId" asp-items="Model.GSTList" class="form-control"></select>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-3">
                    <label>Visa</label>
                    <select asp-for="Service.VisaTypeId" asp-items="Model.VisaTypeList" class="form-control"></select>
                </div>

                <div class="col-md-3">
                    <label>Country</label>
                    <select asp-for="Service.CountryId" asp-items="Model.CountryList" class="form-control"></select>
                </div>

                <div class="col-md-3">
                    <label>Visa Type</label>
                    <select asp-for="Service.VisaTypeId" asp-items="Model.VisaTypeList" class="form-control"></select>
                </div>
            </div>

            <div class="mt-3">
                <label>Description</label>
                <input type="textarea" asp-for="Service.Description" class="form-control"></input>
            </div>

            <!-- CHECKBOX -->
            <div class="row mt-3">
                @foreach (var item in new[]{
                                ("Is Coaching","IsCoaching"),
                                ("Is Combo Service Package?","IsServiceComboPackage"),
                                ("Is In App Visible?","InAppShow"),
                                ("Is Agreements Send?","IsAgreementsSend"),
                                ("Is Receipt Send?","IsReceiptSend"),
                                ("Is College Application Activities?","IsCollegeApplication"),
                                ("Is Intake Show?","IsIntakeShow"),
                                ("Is First Meeting Show?","IsFirstMeetingShow"),
                                ("Is Agreements Send Button Show?","IsAgreementBtn"),
                                ("Is Agreements Download Show?","IsAgreementDownload"),
                                ("Is Receipt Send Button Show?","IsReceiptBtn"),
                                ("Is Receipt Download Show?","IsReceiptDownload"),
                                ("Is Show Invoice?","IsShowInvoice"),
                                ("Is Maximum Amount Allowed?","IsMaxAmount"),
                                ("Is Course Options?","IsCourse"),
                                ("Is Fees Payment?","IsFees"),
                                ("Is Post Decision Activities?","IsPostDecision"),
                                ("Is Allied Services?","IsAllied")
                                })
                {
                    <div class="col-md-2 mb-2">
                        <input type="checkbox"
                               name="Service.@item.Item2"
                               value="Yes"
                               @(Model.Service?.GetType().GetProperty(item.Item2)?.GetValue(Model.Service)?.ToString() == "Yes" ? "checked" : "") />
                        @item.Item1
                    </div>
                }
            </div>

        </div>

        <!-- ================= ACTIVITIES + QUESTIONS ================= -->
        <div class="row mt-3">

            <!-- ACTIVITIES -->
            <div class="col-md-6">
                <div class="card p-3 shadow-sm">

                    <div class="d-flex justify-content-between">
                        <h6>Activities List</h6>
                        <button type="button" class="btn btn-primary btn-sm" onclick="addActivity()">Add Activities</button>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-6">
                            <label>Activities *</label>
                            <select id="activitySelect" class="form-control" asp-items="Model.ActivityList"></select>
                        </div>

                        <div class="col-md-6">
                            <label>Milestone Alias</label>
                            <input id="milestone" class="form-control" />
                        </div>

                        <div class="col-md-6 mt-2">
                            <label>On Activity Completion</label>
                            <input id="duedays" class="form-control" />
                        </div>

                        <div class="col-md-6 mt-2">
                            <label>Amount</label>
                            <input id="amount" class="form-control" value="0" />
                        </div>
                    </div>

                    <table class="table table-bordered mt-3" id="activityTable">
                        <thead>
                            <tr>
                                <th>Activities Name</th>
                                <th>Milestone Alias</th>
                                <th>Payment Due</th>
                                <th>Amount</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total Amount :</td>
                                <td><input id="totalAmount" class="form-control" readonly /></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>

                </div>
            </div>

            <!-- QUESTIONS -->
            <div class="col-md-6">
                <div class="card p-3 shadow-sm">

                    <div class="d-flex justify-content-between">
                        <h6>Activities Question List</h6>
                        <button type="button" class="btn btn-primary btn-sm" onclick="addQuestion()">Add</button>
                    </div>

                    <div class="mt-2">
                        <select id="questionSelect" class="form-control" asp-items="Model.QuestionList"></select>
                    </div>

                    <table class="table mt-3" id="questionTable">
                        <thead>
                            <tr>
                                <th>Question</th>
                                <th>Answer</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                </div>
            </div>

        </div>

        <!-- DOCUMENT -->
        <div class="card mt-3 p-3 shadow-sm">

            <div class="d-flex justify-content-between">
                <h6>Document List</h6>
                <button type="button" class="btn btn-primary btn-sm" onclick="addDocument()">Add</button>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <select id="docType" class="form-control" asp-items="Model.DocumentTypeList"></select>
                </div>
                <div class="col-md-6">
                    <select id="doc" class="form-control" asp-items="Model.DocumentList"></select>
                </div>
            </div>

            <table class="table mt-3" id="docTable">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Document</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

        </div>

        <!-- TERMS -->
        <div class="card mt-3 p-3 shadow-sm">
            <textarea asp-for="Service.TermsAndCondition"></textarea>
        </div>

        <div class="mt-3">
            <button class="btn btn-success">Update</button>
            <a href="/ServicePackage" class="btn btn-danger">Cancel</a>
        </div>

    </div>
</form>

<script>
    var existingActivities = @Html.Raw(Json.Serialize(Model.Activities ?? []));
    var existingQuestions = @Html.Raw(Json.Serialize(Model.Questions ?? []));
    var existingDocuments = @Html.Raw(Json.Serialize(Model.Documents ?? []));

    window.onload = function () {
        existingActivities.forEach(x => addActivity(x));
        existingQuestions.forEach(x => addQuestion(x));
        existingDocuments.forEach(x => addDocument(x));
    };

        let activityIndex = 0;

    function addActivity(data = null) {

        let row = `
        <tr>
            <td>
                <select name="Activities[${activityIndex}].ActivitiesId" class="form-control">
                    ${activityList.map(a =>
                        `<option value="${a.value}" ${data && data.activitiesId == a.value ? "selected" : ""}>${a.text}</option>`
                    ).join("")}
                </select>
            </td>

            <td>
                <input name="Activities[${activityIndex}].MilestoneAlias"
                       value="${data?.milestoneAlias || ""}"
                       class="form-control"/>
            </td>

            <td>
                <input name="Activities[${activityIndex}].DueDays"
                       value="${data?.dueDays || ""}"
                       class="form-control"/>
            </td>

            <td>
                <input name="Activities[${activityIndex}].ActivitiesAmount"
                       value="${data?.activitiesAmount || 0}"
                       class="form-control amount"
                       oninput="calculateTotal()" />
            </td>

            <td>
                <button type="button" onclick="removeRow(this)" class="btn btn-danger btn-sm">X</button>
            </td>
        </tr>`;

        document.querySelector("#activityTable tbody").insertAdjacentHTML('beforeend', row);
        activityIndex++;
    }

        let questionIndex = 0;

    function addQuestion(data = null) {

        let row = `
        <tr>
            <td>
                <select name="Questions[${questionIndex}].Id" class="form-control">
                    ${questionList.map(q =>
                        `<option value="${q.value}" ${data && data.id == q.value ? "selected" : ""}>${q.text}</option>`
                    ).join("")}
                </select>
            </td>

            <td>
                <select name="Questions[${questionIndex}].AnsType" class="form-control">
                    <option ${data?.ansType=="Text"?"selected":""}>Text</option>
                    <option ${data?.ansType=="Dropdown"?"selected":""}>Dropdown</option>
                    <option ${data?.ansType=="Checkbox"?"selected":""}>Checkbox</option>
                </select>
            </td>

            <td>
                <button type="button" onclick="removeRow(this)" class="btn btn-danger btn-sm">X</button>
            </td>
        </tr>`;

        document.querySelector("#questionTable tbody").insertAdjacentHTML('beforeend', row);
        questionIndex++;
    }

        let docIndex = 0;

    function addDocument(data = null) {

        let row = `
        <tr>
            <td>
                <select name="Documents[${docIndex}].DocumentTypeId" class="form-control">
                    ${docTypeList.map(d =>
                        `<option value="${d.value}" ${data && data.documentTypeId == d.value ? "selected" : ""}>${d.text}</option>`
                    ).join("")}
                </select>
            </td>

            <td>
                <select name="Documents[${docIndex}].DocumentId" class="form-control">
                    ${docList.map(d =>
                        `<option value="${d.value}" ${data && data.documentId == d.value ? "selected" : ""}>${d.text}</option>`
                    ).join("")}
                </select>
            </td>

            <td>
                <button type="button" onclick="removeRow(this)" class="btn btn-danger btn-sm">X</button>
            </td>
        </tr>`;

        document.querySelector("#docTable tbody").insertAdjacentHTML('beforeend', row);
        docIndex++;
    }

        function removeRow(btn){
        btn.closest("tr").remove();
        calculateTotal();
    }

    function calculateTotal() {
        let total = 0;
        document.querySelectorAll(".amount").forEach(x => total += parseFloat(x.value) || 0);
        document.getElementById("totalAmount").value = total;
    }

     

    tinymce.init({ selector:'textarea', height:300 });
</script>