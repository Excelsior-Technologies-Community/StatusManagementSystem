@model IntakeModel

<div class="container-fluid mt-3">

    <div class="header-box d-flex justify-content-between">
        <div>
            <h5 class="fw-bold mb-0">EDIT INTAKE</h5>
            <small class="text-muted">Dashboard / Intake / Edit Intake</small>
        </div>

    </div>

    <div class="intake-card">

        <form method="post">

            <input type="hidden" name="ID" value="@Model.ID" />

            <div class="row">
                <div class="col-md-6">
                    <label>Year *</label>
                    <input name="Year" value="@Model.Year" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label>Month *</label>
                    <input name="Month" value="@Model.Month" class="form-control" />
                </div>
            </div>

            <div class="mt-3">
                <label>Remarks</label>
                <textarea name="Remarks" class="form-control">@Model.Remarks</textarea>
            </div>

            <div class="mt-3">
                <button class="btn btn-primary btn-sm">Update</button>
                <a href="/Intake/Index" class="btn btn-secondary btn-sm">Back</a>
            </div>

        </form>

    </div>
</div>