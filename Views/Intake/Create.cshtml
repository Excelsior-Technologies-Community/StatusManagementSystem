@model IntakeModel

<div class="container-fluid mt-3">

    <div class="header-box d-flex justify-content-between">
        <div>
            <h5 class="fw-bold mb-0">ADD INTAKE</h5>
            <small class="text-muted">Dashboard / Intake / Add Intake</small>
        </div>

    </div>

    <div class="intake-card">

        <form method="post">

            <div class="row">
                <div class="col-md-6">
                    <label>Year *</label>
                    <input name="Year" class="form-control" placeholder="Enter Year" required />
                </div>

                <div class="col-md-6">
                    <label>Month *</label>
                    <input name="Month" class="form-control" placeholder="Enter Month" required />
                </div>
            </div>

            <div class="mt-3">
                <label>Remarks</label>
                <textarea name="Remarks" class="form-control" placeholder="Enter Remarks"></textarea>
            </div>

            <div class="mt-3">
                <button name="submit" value="Save" class="btn btn-primary btn-sm">Save</button>
                <button name="submit" value="SaveAdd" class="btn btn-success btn-sm">Save & Add Another</button>
                <a href="/Intake/Index" class="btn btn-danger btn-sm">Cancel</a>
            </div>

        </form>

    </div>
</div>