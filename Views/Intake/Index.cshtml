@model List<IntakeModel>

<div class="container-fluid mt-3">

    <!-- HEADER -->
    <div class="header-box d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">INTAKE</h5>
            <small class="text-muted">Dashboard / Intake</small>
        </div>

        <div>
            <a href="/Intake/Create" class="btn btn-primary btn-sm">ADD</a>
            <button class="btn btn-outline-primary btn-sm">Download</button>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="header-box d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Intake List</h6>

        <div class="d-flex align-items-center">
            <input type="text" placeholder="search" class="form-control form-control-sm me-2" style="width:200px;" />
            <span class="me-2">Show</span>
            <select class="form-select form-select-sm" style="width:80px;">
                <option>10</option>
                <option>50</option>
                <option>100</option>
            </select>
            <span class="ms-2">entries</span>
        </div>
    </div>

    <!-- LIST -->
    @for (int i = 0; i < Model.Count; i++)
    {
        var item = Model[i];

        <div class="intake-card">

            <div class="intake-title-box">
                @(i + 1)
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="label-title">Year</div>
                    <div class="value-text">@item.Year</div>
                </div>

                <div class="col-md-3">
                    <div class="label-title">Month</div>
                    <div class="value-text">@item.Month</div>
                </div>

                <div class="col-md-3">
                    <div class="label-title">Remarks</div>
                    <div class="value-text">@item.Remarks</div>
                </div>

                <div class="col-md-3">
                    <div class="label-title">Status</div>
                    <span class="@(item.StatusFlag == "Active" ? "text-success" : "text-danger") fw-bold">
                        @(item.StatusFlag == "Active" ? "Active" : "Inactive")
                    </span>
                </div>
            </div>

            <hr />

            <div class="d-flex gap-2">
                <a href="/Intake/Edit/@item.ID" class="btn btn-edit btn-sm">✏ Edit</a>

                @if (item.StatusFlag == "Active")
                {
                    <a href="/Intake/ChangeStatus?id=@item.ID&status=I"
                       class="btn btn-outline-danger btn-sm">⛔ InActive</a>
                }
                else
                {
                    <a href="/Intake/ChangeStatus?id=@item.ID&status=A"
                       class="btn btn-outline-success btn-sm">✔ Active</a>
                }

                <a href="/Intake/Delete/@item.ID" class="btn btn-delete btn-sm">🗑 Delete</a>
            </div>

        </div>
    }

</div>