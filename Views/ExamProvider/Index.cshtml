@model List<ExamProviderVM>

<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">EXAM PROVIDER</h4>
            <small class="text-muted">Dashboard / Exam Provider</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/ExamProvider/Create" class="btn btn-primary px-4">ADD</a>
            <button class="btn btn-outline-primary">Download</button>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="card shadow-sm border-0 rounded-3 mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">

            <h6 class="fw-semibold mb-0">Exam Provider List</h6>

            <div class="d-flex gap-3 align-items-center">
                <input type="text" id="searchBox" class="form-control" placeholder="search" style="width:220px;" />

                <div>
                    Show
                    <select class="form-select d-inline w-auto">
                        <option>50</option>
                    </select>
                    entries
                </div>
            </div>

        </div>
    </div>

    <!-- LIST -->
    @foreach (var item in Model)
    {
        <div class="card shadow-sm border-0 rounded-3 mb-4 exam-card">

            <div class="card-body">

                <!-- TOP -->
                <div class="d-flex justify-content-between">

                    <span class="badge bg-light border text-dark px-3 py-2">@item.Id</span>

                   

                </div>

                <div class="row mt-3">

                    <div class="col-md-3">
                        <small class="text-muted">Exam Type</small>
                        <div class="fw-semibold">@item.ExamTypeName</div>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted">Exam Provider</small>
                        <div class="fw-semibold">@item.Title</div>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted">Description</small>
                        <div>@item.Description</div>
                    </div>

                    <div class="col-md-3">
                        <small class="text-muted">Status</small>
                        <div class="fw-semibold @(item.StatusFlag == "Active" ? "text-success" : "text-danger")">
                            @item.StatusFlag
                        </div>
                    </div>

                </div>

                <hr />

                <!-- ACTION -->
                <div class="d-flex gap-2">

                    <a href="/ExamProvider/Edit/@item.Id" class="btn btn-outline-primary btn-sm">✏ Edit</a>

                    @if (item.StatusFlag == "Active")
                    {
                        <a href="/ExamProvider/ToggleStatus/@item.Id"
                           class="btn btn-outline-danger btn-sm">⛔ InActive</a>
                    }
                    else
                    {
                        <a href="/ExamProvider/ToggleStatus/@item.Id"
                           class="btn btn-outline-success btn-sm">✔ Active</a>
                    }

                    <a href="/ExamProvider/Delete/@item.Id" class="btn btn-outline-danger btn-sm">
                        🗑 Delete
                    </a>

                </div>

            </div>
        </div>
    }

</div>

<style>
    .exam-card {
        border-radius: 12px;
    }

        .exam-card:hover {
            transform: scale(1.01);
            transition: 0.2s;
        }
</style>

<script>
    document.getElementById("searchBox").addEventListener("keyup", function () {
        let val = this.value.toLowerCase();
        document.querySelectorAll(".exam-card").forEach(c => {
            c.style.display = c.innerText.toLowerCase().includes(val) ? "" : "none";
        });
    });
</script>