@model List<ExamScheduleVM>

<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark">SCHEDULE EXAMINATION LIST</h4>
            <small class="text-muted">Dashboard / Schedule Examination List</small>
        </div>

        <div>
            <a href="/ExamSchedule/Create" class="btn btn-primary px-4">ADD</a>
        </div>
    </div>

    <!-- SEARCH CARD -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body py-3 px-4 d-flex justify-content-between align-items-center">

            <h6 class="mb-0 fw-semibold">Schedule Examination List</h6>

            <div class="d-flex align-items-center">
                <input type="text" class="form-control me-2" placeholder="search" style="width:200px" />
                <span class="me-2">Show</span>

                <select class="form-select me-2" style="width:80px">
                    <option>50</option>
                </select>

                <span>entries</span>
            </div>

        </div>
    </div>

    <!-- LIST -->
    @foreach (var item in Model)
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body px-4 py-3">

                <!-- ID BADGE -->
                <span class="badge bg-light border text-dark">@item.Id</span>

                <!-- TOP ROW -->
                <div class="row mt-3">

                    <div class="col-md-4">
                        <small class="text-muted">Title</small>
                        <div class="fw-semibold">@item.Title</div>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted">Exam Type</small>
                        <div class="fw-semibold">@item.ExamTypeName</div>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted">Result Date</small>
                        <div class="fw-semibold">@item.ResultDate?.ToString("dd-MM-yyyy")</div>
                    </div>

                </div>

                <hr />

                <!-- EXAM DETAIL SECTION -->
                <div class="row">

                    <div class="col-md-4">
                        <small class="text-muted">Exam Detail</small>
                        <div class="fw-semibold">Exam Detail</div>
                    </div>

                </div>

                <hr />

                <!-- ACTION BUTTONS -->
                <div class="mt-2">

                    <a href="/ExamSchedule/Edit/@item.Id" class="btn btn-outline-primary btn-sm me-2">
                        ✏ Edit
                    </a>

                    <a href="/ExamSchedule/ToggleStatus/@item.Id"
                       class="btn btn-outline-warning btn-sm me-2">
                        ⛔ @(item.StatusFlag == "Active" ? "InActive" : "Active")
                    </a>

                    <a href="/ExamSchedule/Delete/@item.Id"
                       class="btn btn-outline-danger btn-sm">
                        🗑 Delete
                    </a>

                </div>

            </div>
        </div>
    }

</div>