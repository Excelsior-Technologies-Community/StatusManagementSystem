@model InstituteTypeModel

<div class="container-fluid mt-3">

    <div class="header-box d-flex justify-content-between">
        <div>
            <h5>EDIT INSTITUTE TYPE</h5>
            <small>Dashboard / Institute Type / Edit Institute Type</small>
        </div>

    </div>

    <div class="intake-card">

        <form method="post">

            <input type="hidden" name="ID" value="@Model.ID" />

            <div class="row">
                <div class="col-md-6">
                    <label>Title</label>
                    <input name="Title" value="@Model.Title" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label>Short Name</label>
                    <input name="ShortName" value="@Model.ShortName" class="form-control" />
                </div>
            </div>

            <div class="mt-3">
                <label>Description</label>
                <textarea name="Description" class="form-control">@Model.Description</textarea>
            </div>

            <div class="mt-3">
                <button class="btn btn-primary btn-sm">Update</button>
            </div>

        </form>

    </div>
</div>