@model ExamCenterVM

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between mb-3">
        <div>
            <h4 class="fw-bold">ADD EXAM CENTER</h4>
            <small class="text-muted">Dashboard / Exam Center / Add Exam Center</small>
        </div>

        <a href="/ExamCenter/Index" class="btn btn-primary">BACK</a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            <form method="post">

                <!-- ROW 1 -->
                <div class="row">
                    <div class="col-md-4">
                        <label>Center Name *</label>
                        <input name="ExamCenterName" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label>Exam Provider *</label>
                        @Html.DropDownListFor(x => x.ExamProviderId, Model.ProviderList, "Select Exam Provider", new { @class = "form-control" })
                    </div>

                    <div class="col-md-4">
                        <label>Country</label>
                        @Html.DropDownListFor(x => x.CountryId, Model.CountryList, "Select Country", new { @class = "form-control", id = "CountryId" })
                    </div>
                </div>

                <!-- ROW 2 -->
                <div class="row mt-3">
                    <div class="col-md-4">
                        <label>State</label>
                        <select id="StateId" name="StateId" class="form-control"></select>
                    </div>

                    <div class="col-md-4">
                        <label>City</label>
                        <select id="CityId" name="CityId" class="form-control"></select>
                    </div>

                    <div class="col-md-4">
                        <label>Area</label>
                        <select id="AreaId" name="AreaId" class="form-control"></select>
                    </div>
                </div>

                <!-- ROW 3 -->
                <div class="row mt-3">
                    <div class="col-md-4">
                        <label>Pincode</label>
                        <input name="Pincode" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label>Email</label>
                        <input name="Email" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label>Mobile</label>
                        <input name="MobileNo" class="form-control" />
                    </div>
                </div>

                <div class="mt-3">
                    <label>Address</label>
                    <textarea name="Address" class="form-control"></textarea>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary">Save</button>
                    <button class="btn btn-success">Save & Add Another</button>
                    <a href="/ExamCenter/Index" class="btn btn-danger">Cancel</a>
                </div>

            </form>

        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    // COUNTRY → STATE
    $('#CountryId').change(function () {

        let countryId = $(this).val();

        $('#StateId').html('<option>Loading...</option>');
        $('#CityId').html('<option>Select City</option>');
        $('#AreaId').html('<option>Select Area</option>');

        $.get('/ExamCenter/GetStates', { countryId: countryId }, function (data) {

            $('#StateId').empty().append('<option>Select State</option>');

            $.each(data, function (i, v) {
                $('#StateId').append(`<option value="${v.value}">${v.text}</option>`);
            });

        });
    });

    // STATE → CITY
    $('#StateId').change(function () {

        let stateId = $(this).val();

        $('#CityId').html('<option>Loading...</option>');
        $('#AreaId').html('<option>Select Area</option>');

        $.get('/ExamCenter/GetCities', { stateId: stateId }, function (data) {

            $('#CityId').empty().append('<option>Select City</option>');

            $.each(data, function (i, v) {
                $('#CityId').append(`<option value="${v.value}">${v.text}</option>`);
            });

        });
    });

    // CITY → AREA
    $('#CityId').change(function () {

        let cityId = $(this).val();

        $('#AreaId').html('<option>Loading...</option>');

        $.get('/ExamCenter/GetAreas', { cityId: cityId }, function (data) {

            $('#AreaId').empty().append('<option>Select Area</option>');

            $.each(data, function (i, v) {
                $('#AreaId').append(`<option value="${v.value}">${v.text}</option>`);
            });

        });
    });
</script>