@model ExamCenterVM

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between mb-3">
        <div>
            <h4 class="fw-bold">EDIT EXAM CENTER</h4>
            <small class="text-muted">Dashboard / Exam Center / Edit Exam Center</small>
        </div>

        <a href="/ExamCenter/Index" class="btn btn-primary">BACK</a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            <form method="post">

                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="row">
                    <div class="col-md-4">
                        <label>Center Name *</label>
                        <input name="ExamCenterName" value="@Model.ExamCenterName" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label>Exam Provider *</label>
                        @Html.DropDownListFor(x => x.ExamProviderId, Model.ProviderList, new { @class = "form-control" })
                    </div>

                    <div class="col-md-4">
                        <label>Country</label>
                        @Html.DropDownListFor(x => x.CountryId, Model.CountryList, new { @class = "form-control", id = "CountryId" })
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-4">
                        <label>State</label>
                        @Html.DropDownListFor(x => x.StateId, Model.StateList, new { @class = "form-control", id = "StateId" })
                    </div>

                    <div class="col-md-4">
                        <label>City</label>
                        @Html.DropDownListFor(x => x.CityId, Model.CityList, new { @class = "form-control", id = "CityId" })
                    </div>

                    <div class="col-md-4">
                        <label>Area</label>
                        @Html.DropDownListFor(x => x.AreaId, Model.AreaList, new { @class = "form-control", id = "AreaId" })
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-4">
                        <label>Pincode</label>
                        <input name="Pincode" value="@Model.Pincode" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label>Email</label>
                        <input name="Email" value="@Model.Email" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label>Mobile</label>
                        <input name="MobileNo" value="@Model.MobileNo" class="form-control" />
                    </div>
                </div>

                <div class="mt-3">
                    <label>Address</label>
                    <textarea name="Address" class="form-control">@Model.Address</textarea>
                </div>

                <button class="btn btn-primary mt-3">Update</button>

            </form>

        </div>
    </div>
</div>