@model List<ExamCenterVM>

<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">EXAM CENTER</h4>
            <small class="text-muted">Dashboard / Exam Center</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/ExamCenter/Create" class="btn btn-primary px-4">ADD</a>
            <button class="btn btn-outline-primary">Download</button>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="card shadow-sm border-0 rounded-3 mb-3">
        <div class="card-body d-flex justify-content-between">
            <h6 class="fw-semibold mb-0">Exam Center List</h6>

            <div class="d-flex gap-3">
                <input type="text" id="searchBox" class="form-control" placeholder="search" style="width:200px;" />
                <div>
                    Show
                    <select class="form-select d-inline w-auto">
                        <option>50</option>
                    </select>
                    entries
                </div>
            </div>
        </div>
    </div>

    <!-- LIST -->
    @foreach (var item in Model)
    {
        <div class="card shadow-sm border-0 rounded-3 mb-4 exam-card">
            <div class="card-body">

                <span class="badge bg-light border text-dark">@item.Id</span>

                <div class="row mt-3">

                    <div class="col-md-4">
                        <small class="text-muted">Center Name</small>
                        <div class="fw-semibold">@item.ExamCenterName</div>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted">Provider</small>
                        <div class="fw-semibold">@item.ProviderName</div>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted">Status</small>
                        <div class="fw-semibold @(item.StatusFlag == "Active" ? "text-success" : "text-danger")">
                            @item.StatusFlag
                        </div>
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">
                    <a href="/ExamCenter/Edit/@item.Id" class="btn btn-outline-primary btn-sm">✏ Edit</a>

                    @if (item.StatusFlag == "Active")
                    {
                        <a href="/ExamCenter/ToggleStatus/@item.Id" class="btn btn-outline-danger btn-sm">⛔ InActive</a>
                    }
                    else
                    {
                        <a href="/ExamCenter/ToggleStatus/@item.Id" class="btn btn-outline-success btn-sm">✔ Active</a>
                    }

                    <a href="/ExamCenter/Delete/@item.Id" class="btn btn-outline-danger btn-sm">🗑 Delete</a>
                </div>

            </div>
        </div>
    }

</div>

<script>
    document.getElementById("searchBox").addEventListener("keyup", function () {
        let val = this.value.toLowerCase();
        document.querySelectorAll(".exam-card").forEach(c => {
            c.style.display = c.innerText.toLowerCase().includes(val) ? "" : "none";
        });
    });
</script>