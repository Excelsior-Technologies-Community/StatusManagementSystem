@model InstituteModel

<form method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="ID" />

    <div class="container-fluid mt-3">

        <!-- HEADER -->
        <div class="header-box d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0">EDIT INSTITUTE</h5>
                <small class="text-muted">Dashboard / Institute / Edit Institute</small>
            </div>

            <a href="/Institute/Index" class="btn btn-primary btn-sm">BACK</a>
        </div>

        <!-- FORM CARD -->
        <div class="intake-card">

            <!-- ROW 1 -->
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Institute Type *</label>
                    @Html.DropDownListFor(m => m.InstituteTypeId, Model.InstituteTypeList, "Select Institute Type", new { @class = "form-control" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Institute Name *</label>
                    <input asp-for="InstituteName" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Contact No.</label>
                    <input asp-for="ContactNumber" class="form-control" />
                </div>
            </div>

            <!-- ROW 2 -->
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Website</label>
                    <input asp-for="Website" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Institute Code</label>
                    <input asp-for="Institutecode" class="form-control" />
                </div>
            </div>

            <!-- CASCADE DROPDOWNS -->
            <div class="row g-3 mt-1">

                <div class="col-md-3">
                    <label class="form-label">Country *</label>
                    @Html.DropDownListFor(m => m.CountryId, Model.CountryList, "Select Country", new { @class = "form-control", id = "CountryId" })
                </div>

                <div class="col-md-3">
                    <label class="form-label">State *</label>
                    <select id="StateId" name="StateId" class="form-control">
                        <option>Select State</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">City *</label>
                    <select id="CityId" name="CityId" class="form-control">
                        <option>Select City</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Area</label>
                    <select id="AreaId" name="AreaId" class="form-control">
                        <option>Select Area</option>
                    </select>
                </div>

            </div>

            <!-- ADDRESS -->
            <div class="mt-3">
                <label class="form-label">Address *</label>
                <textarea asp-for="Address" class="form-control"></textarea>
            </div>

            <!-- REMARKS -->
            <div class="mt-3">
                <label class="form-label">Remarks</label>
                <textarea asp-for="Remarks" class="form-control"></textarea>
            </div>

            <!-- LOGO -->
            <div class="mt-3 d-flex align-items-center gap-3">
                <div>
                    <label class="form-label">Logo</label><br />
                    <input type="file" name="file" class="form-control" />
                </div>

                <div class="text-center">
                    @if (!string.IsNullOrEmpty(Model.InstituteLogo))
                    {
                        <img src="~/Uploads/@Model.InstituteLogo" width="120" height="120" style="border-radius:50%;" />
                    }
                    else
                    {
                        <div style="width:120px;height:120px;border-radius:50%;border:1px solid #ccc;display:flex;align-items:center;justify-content:center;">
                            NO IMAGE<br />AVAILABLE
                        </div>
                    }
                </div>
            </div>

            <!-- BUTTON -->
            <div class="mt-3">
                <button class="btn btn-primary btn-sm">Update</button>
                <a href="/Institute/Index" class="btn btn-danger btn-sm">Cancel</a>
            </div>

        </div>
    </div>

</form>

<!-- JQUERY -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {

        var countryId = '@Model.CountryId';
        var stateId = '@Model.StateId';
        var cityId = '@Model.CityId';
        var areaId = '@Model.AreaId';

        if (countryId) {
            loadStates(countryId, stateId);
        }

        $("#CountryId").change(function () {
            loadStates($(this).val(), null);
        });

        $("#StateId").change(function () {
            loadCities($(this).val(), null);
        });

        $("#CityId").change(function () {
            loadAreas($(this).val(), null);
        });

        function loadStates(countryId, selectedStateId) {

            $.ajax({
                url: '@Url.Action("GetStates", "Institute")',
                type: 'GET',
                data: { countryId: countryId },
                success: function (data) {

                    var options = '<option>Select State</option>';

                    $.each(data, function (i, item) {
                        options += `<option value="${item.id}">${item.text}</option>`;
                    });

                    $("#StateId").html(options);

                    if (selectedStateId) {
                        $("#StateId").val(selectedStateId);
                        loadCities(selectedStateId, cityId);
                    }
                }
            });
        }

        function loadCities(stateId, selectedCityId) {

            $.ajax({
                url: '@Url.Action("GetCities", "Institute")',
                type: 'GET',
                data: { stateId: stateId },
                success: function (data) {

                    var options = '<option>Select City</option>';

                    $.each(data, function (i, item) {
                        options += `<option value="${item.id}">${item.text}</option>`;
                    });

                    $("#CityId").html(options);

                    if (selectedCityId) {
                        $("#CityId").val(selectedCityId);
                        loadAreas(selectedCityId, areaId);
                    }
                }
            });
        }

        function loadAreas(cityId, selectedAreaId) {

            $.ajax({
                url: '@Url.Action("GetAreas", "Institute")',
                type: 'GET',
                data: { cityId: cityId },
                success: function (data) {

                    var options = '<option>Select Area</option>';

                    $.each(data, function (i, item) {
                        options += `<option value="${item.id}">${item.text}</option>`;
                    });

                    $("#AreaId").html(options);

                    if (selectedAreaId) {
                        $("#AreaId").val(selectedAreaId);
                    }
                }
            });
        }

    });
</script>