@model InstituteModel

<form method="post" enctype="multipart/form-data">

    <div class="container-fluid mt-3">

        <!-- HEADER -->
        <div class="header-box d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0">ADD INSTITUTE</h5>
                <small class="text-muted">Dashboard / Institute / Add Institute</small>
            </div>

            <a href="/Institute/Index" class="btn btn-primary btn-sm">BACK</a>
        </div>

        <!-- FORM CARD -->
        <div class="intake-card">

            <!-- ROW 1 -->
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Institute Type *</label>
                    @Html.DropDownListFor(m => m.InstituteTypeId, Model.InstituteTypeList, "Select Institute Type", new { @class = "form-control" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Institute Name *</label>
                    <input asp-for="InstituteName" class="form-control" placeholder="Enter Institute Name" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Contact No.</label>
                    <input asp-for="ContactNumber" class="form-control" placeholder="Enter Contact No." />
                </div>
            </div>

            <!-- ROW 2 -->
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Enter Email" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Website</label>
                    <input asp-for="Website" class="form-control" placeholder="Enter Website" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Institute Code</label>
                    <input asp-for="Institutecode" class="form-control" placeholder="Enter Institute Code" />
                </div>
            </div>

            <!-- CASCADE -->
            <div class="row g-3 mt-1">

                <div class="col-md-3">
                    <label class="form-label">Country *</label>
                    @Html.DropDownListFor(m => m.CountryId, Model.CountryList, "Select Country", new { @class = "form-control", id = "CountryId" })
                </div>

                <div class="col-md-3">
                    <label class="form-label">State *</label>
                    <select id="StateId" name="StateId" class="form-control" disabled>
                        <option>Select State</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">City *</label>
                    <select id="CityId" name="CityId" class="form-control" disabled>
                        <option>Select City</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Area</label>
                    <select id="AreaId" name="AreaId" class="form-control" disabled>
                        <option>Select Area</option>
                    </select>
                </div>

            </div>

            <!-- ADDRESS -->
            <div class="mt-3">
                <label class="form-label">Address *</label>
                <textarea asp-for="Address" class="form-control"></textarea>
            </div>

            <!-- REMARKS -->
            <div class="mt-3">
                <label class="form-label">Remarks</label>
                <textarea asp-for="Remarks" class="form-control"></textarea>
            </div>

            <!-- LOGO -->
            <div class="mt-3 d-flex align-items-center gap-3">
                <div>
                    <label class="form-label">Logo</label><br />
                    <input type="file" name="file" class="form-control" />
                </div>

                <div class="text-center">
                    <div style="width:120px;height:120px;border-radius:50%;border:1px solid #ccc;display:flex;align-items:center;justify-content:center;">
                        NO IMAGE<br />AVAILABLE
                    </div>
                </div>
            </div>

            <!-- BUTTONS -->
            <div class="mt-3">
                <button class="btn btn-primary btn-sm">Save</button>
                <button name="submit" value="SaveAdd" class="btn btn-success btn-sm">Save & Add Another</button>
                <a href="/Institute/Index" class="btn btn-danger btn-sm">Cancel</a>
            </div>

        </div>
    </div>

</form>

<!-- JQUERY -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {

        // COUNTRY → STATE
        $("#CountryId").change(function () {

            var countryId = $(this).val();

            $("#StateId").prop("disabled", true).html('<option>Loading...</option>');
            $("#CityId").prop("disabled", true).html('<option>Select City</option>');
            $("#AreaId").prop("disabled", true).html('<option>Select Area</option>');

            if (countryId) {

                $.ajax({
                    url: '@Url.Action("GetStates", "Institute")',
                    type: 'GET',
                    data: { countryId: countryId },
                    success: function (data) {

                        var options = '<option>Select State</option>';

                        $.each(data, function (i, item) {
                            options += `<option value="${item.id}">${item.text}</option>`;
                        });

                        $("#StateId").html(options).prop("disabled", false);
                    }
                });

            }
        });


        // STATE → CITY
        $("#StateId").change(function () {

            var stateId = $(this).val();

            $("#CityId").prop("disabled", true).html('<option>Loading...</option>');
            $("#AreaId").prop("disabled", true).html('<option>Select Area</option>');

            if (stateId) {

                $.ajax({
                    url: '@Url.Action("GetCities", "Institute")',
                    type: 'GET',
                    data: { stateId: stateId },
                    success: function (data) {

                        var options = '<option>Select City</option>';

                        $.each(data, function (i, item) {
                            options += `<option value="${item.id}">${item.text}</option>`;
                        });

                        $("#CityId").html(options).prop("disabled", false);
                    }
                });

            }
        });


        // CITY → AREA
        $("#CityId").change(function () {

            var cityId = $(this).val();

            $("#AreaId").prop("disabled", true).html('<option>Loading...</option>');

            if (cityId) {

                $.ajax({
                    url: '@Url.Action("GetAreas", "Institute")',
                    type: 'GET',
                    data: { cityId: cityId },
                    success: function (data) {

                        var options = '<option>Select Area</option>';

                        $.each(data, function (i, item) {
                            options += `<option value="${item.id}">${item.text}</option>`;
                        });

                        $("#AreaId").html(options).prop("disabled", false);
                    }
                });

            }
        });

    });
</script>